LWS = (' ' | '\t')+

BODY = SCOPE_START ((LWS LINE)? '\n')+ SCOPE_END

LINE = EXPR
LINE = STMT
LINE = LINE ';' LINE

FUNCALL = IDENTIFIER '(' ARGS? ')'
ARGS = EXPR (',' EXPR)*

EXPR = LITERAL
EXPR = IDENTIFIER
EXPR = FUNCALL
EXPR = EXPR BINARY_OP EXPR
EXPR = UNARY_OP EXPR
EXPR = '(' EXPR ')''
EXPR = EXPR 'if' COND 'else' EXPR
EXPR = '[' EXPR (',' EXPR)* ']'
EXPR = '{' (CONSTANT ':' EXPR (',' CONSTANT ':' EXPR))+ '}'
EXPR = '{' (LITERAL '=' EXPR (',' LITERAL '=' EXPR))+ '}'

VAR_DECL = 'var' IDENTIFIER '=' EXPR
VAR_DECL = 'var' IDENTIFIER ':=' EXPR
VAR_DECL = 'var' IDENTIFIER ':' IDENTIFIER '=' EXPR
EXPORT_VAR = EXPORT VAR_DECL

FUNC_DECL = 'func' IDENTIFIER '(' PARAM_LIST? ')' ':' LINE '\n'
FUNC_DECL = 'func' IDENTIFIER '(' PARAM_LIST? ')' ':' '\n' BODY
FUNC_DECL = 'func' IDENTIFIER '(' PARAM_LIST? ')' '->' (IDENTIFIER | 'void') ':' '\n' BODY

SIGNAL_DECL = 'signal' IDENTIFIER '(' PARAM_LIST? ')' '\n'
SIGNAL_DECL = 'signal' IDENTIFIER '\n'

PARAM_LIST = PARAM (',' PARAM)* (',' DEFAULT_PARAM)*
PARAM_LIST = DEFAULT_PARAM (',' DEFAULT_PARAM)*
PARAM = IDENTIFIER
PARAM = IDENTIFIER ':' INDENTIFIER
DEFAULT_PARAM = IDENTIFIER ':=' LITERAL
DEFAULT_PARAM = IDENTIFIER ':' IDENTIFIER '=' LITERAL

ENUM_DECL = 'enum' IDENTIFIER+ '{' ENUM_LIST '}'
ENUM_LIST = ENUM_ITEM (', ' '\n'+ ENUM_ITEM)*
ENUM_ITEM = IDENTIFIER
ENUM_ITEM = IDENTIFIER '=' LITERAL

SUBCLASS_DECL = 'class' IDENTIFIER '\n' CLASS_BODY?

CLASS = ANNOT_TOOL? ('class_name' IDENTIFIER)? '\n'? (extends IDENTIFIER) '\n' CLASS_BODY?
CLASS_STMT = EXPORT_VAR
CLASS_STMT = VAR_DECL
CLASS_STMT = SIGNAL_DECL
CLASS_STMT = ENUM_DECL
CLASS_STMT = FUNC_DECL
CLASS_STMT = SUBCLASS_DECL


FORLOOP = 'for' IDENTIFIER 'in' EXPR ':' '\n' BODY
WHILELOOP = 'while' COND ':' '\n' BODY

COND = EXPR
COND = '(' EXPR ')'

ELSEIF = IF ELIF* ELSE?
IF = 'if' COND ':' '\n' BODY
IF = 'if' COND ':' LINE
ELIF = elif COND ':' '\n' BODY
ELIF = elif COND ':' LINE
ELSE = else ':' '\n' BODY
ELSE = else ':' LINE

STMT = FUNCALL
STMT = FORLOOP
STMT = WHILELOOP
STMT = ELSEIF
STMT = 'pass'
STMT = 'continue'
STMT = 'break'